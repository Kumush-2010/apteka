generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  phone     String     @unique @db.VarChar(20)
  password  String
  role      Role
  createdAt DateTime   @default(now()) @db.Timestamp(0)
  updatedAt DateTime   @updatedAt @db.Timestamp(0)
  pharmacy  Pharmacy[]
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  phone     String     @unique @db.VarChar(20)
  password  String
  role      Role
  createdAt DateTime   @default(now()) @db.Timestamp(0)
  updatedAt DateTime   @updatedAt @db.Timestamp(0)
  pharmacy  Pharmacy[]
}

model Pharmacy {
  id          Int        @id @default(autoincrement())
  name        String
  address     String
  locationUrl String
  latitude    Float
  longitude   Float
  destination String
  phone       String     @unique @db.VarChar(20)
  adminId     Int
  supplierId  Int
  medicine    Medicine[]
  admin       Admin      @relation(fields: [adminId], references: [id])
  supplier    Supplier   @relation(fields: [supplierId], references: [id])
}

model Medicine {
  id              Int        @id @default(autoincrement())
  uz_name         String
  ru_name         String
  en_name         String
  made            String
  one_plate       String
  one_box         String
  one_plate_price Int
  one_box_price   Int
  warehouse       Int
  image_path      String
  image           String
  pharmacyId      Int
  gram            String
  cartItems       CartItem[]
  pharmacy        Pharmacy   @relation(fields: [pharmacyId], references: [id])
}

model User {
  id         BigInt        @id @default(autoincrement())
  telegramId BigInt     @unique
  name       String?
  language   String?
  role       Role?
  createdAt  DateTime   @default(now())
  phone      String?
  cartItems  CartItem[]
  orders     Order[]
}

model CartItem {
  id         Int       @id @default(autoincrement())
  userId     BigInt
  name       String
  quantity   Int       @default(1)
  createdAt  DateTime  @default(now())
  medicineId Int?
  price      Float?
  medicine   Medicine? @relation(fields: [medicineId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model Order {
  id               Int         @id @default(autoincrement())
  userId           BigInt
  createdAt        DateTime    @default(now())
  status           String      @default("pending")
  totalPrice       Float
  currentLocation  String?
  deliveryLocation String?
  user             User        @relation(fields: [userId], references: [id])
  items            OrderItem[]
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  orderId  Int
  name     String
  quantity Int
  price    Float?
  order    Order  @relation(fields: [orderId], references: [id])
}

enum Role {
  admin
  superAdmin
  supplier
  User
}
